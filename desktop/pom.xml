<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.copperhead</groupId>
		<artifactId>parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>
	<artifactId>desktop</artifactId>
	<packaging>jar</packaging>
	<name>Copperhead Desktop Application</name>
	<description>Native installers: the application, its Java runtime and its browser engine in one package.</description>
	<properties>
		<mainClass>org.copperhead.shell.Copperhead</mainClass>
		<input>${project.build.directory}/input</input>
		<dist>${project.build.directory}/dist</dist>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.copperhead</groupId>
			<artifactId>shell</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>me.friwi</groupId>
			<artifactId>jcefmaven</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
			</plugin>
			<plugin>
				<!-- Everything in the input folder goes on the application's classpath, so jars left over
				     from another version would be loaded next to the new ones. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.3.2</version>
				<executions>
					<execution>
						<id>stale-jars</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>clean</goal>
						</goals>
						<configuration>
							<excludeDefaultDirectories>true</excludeDefaultDirectories>
							<filesets>
								<fileset>
									<directory>${input}</directory>
									<includes>
										<include>*.jar</include>
									</includes>
								</fileset>
							</filesets>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<id>installer-version</id>
						<phase>initialize</phase>
						<goals>
							<goal>parse-version</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<id>application-jars</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<outputDirectory>${input}</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>browser-engine</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>org.copperhead.desktop.PrepareCef</mainClass>
							<arguments>
								<argument>${input}/jcef</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.panteleyev</groupId>
				<artifactId>jpackage-maven-plugin</artifactId>
				<version>1.8.0</version>
				<configuration>
					<name>Copperhead</name>
					<vendor>Adam Waldenberg</vendor>
					<description>Copperhead: an Amiga demo and game studio for Linux.</description>
					<copyright>Copyright © 2026 Adam Waldenberg</copyright>
					<!-- Installers take a plain number, which a snapshot is not. -->
					<appVersion>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</appVersion>
					<destination>${dist}</destination>
				</configuration>
				<executions>
					<execution>
						<id>appimage</id>
						<phase>package</phase>
						<goals>
							<goal>jpackage</goal>
						</goals>
						<configuration>
							<type>APP_IMAGE</type>
							<removeDestination>true</removeDestination>
							<input>${input}</input>
							<mainJar>shell-${project.version}.jar</mainJar>
							<mainClass>${mainClass}</mainClass>
							<addModules>
								<addModule>java.base</addModule>
								<addModule>java.desktop</addModule>
								<addModule>java.instrument</addModule>
								<addModule>java.management</addModule>
								<addModule>java.naming</addModule>
								<addModule>java.net.http</addModule>
								<addModule>java.sql</addModule>
								<!-- jdeps cannot see modules that are found through service lookup: the window
								     toolkit loads jdk.accessibility for screen readers, and Jetty reads its
								     stylesheets out of the jar through jdk.zipfs. -->
								<addModule>jdk.accessibility</addModule>
								<addModule>jdk.unsupported</addModule>
								<addModule>jdk.zipfs</addModule>
							</addModules>
							<jLinkOptions>
								<jLinkOption>--strip-debug</jLinkOption>
								<jLinkOption>--no-man-pages</jLinkOption>
								<jLinkOption>--no-header-files</jLinkOption>
								<jLinkOption>--compress=zip-6</jLinkOption>
							</jLinkOptions>
							<javaOptions>
								<option>--add-opens</option>
								<option>java.base/java.lang=ALL-UNNAMED</option>
								<option>--enable-native-access=ALL-UNNAMED</option>
								<option>-Dcopperhead.jcef=$APPDIR/jcef</option>
							</javaOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Runs the installed packages, so they have to exist before the integration phase. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>linux</id>
			<activation>
				<os>
					<name>linux</name>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>appimage</id>
								<configuration>
									<icon>${project.basedir}/src/main/packaging/icons/copperhead-1024x1024.png</icon>
								</configuration>
							</execution>
							<execution>
								<id>deb</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>DEB</type>
									<appImage>${dist}/Copperhead</appImage>
									<licenseFile>${project.basedir}/../COPYING</licenseFile>
									<!-- Its control file names the dependencies itself. Those jpackage finds are the
									     exact packages of the computer that builds, and the libraries renamed since,
									     such as Ubuntu 24.04's t64 ones and libunistring5, would make the package
									     impossible to install on newer releases. The t64 names come first: on Ubuntu
									     24.04 the old name libasound2 is only provided by an OSS shim that lacks
									     symbols the browser engine needs. -->
									<resourceDir>${project.basedir}/src/main/packaging/linux</resourceDir>
									<linuxPackageName>copperhead</linuxPackageName>
									<linuxAppCategory>devel</linuxAppCategory>
									<linuxMenuGroup>Development</linuxMenuGroup>
									<linuxShortcut>true</linuxShortcut>
									<icon>${project.basedir}/src/main/packaging/icons/copperhead-1024x1024.png</icon>
									<linuxDebMaintainer>adam@adeptum.se</linuxDebMaintainer>
								</configuration>
							</execution>
							<execution>
								<id>rpm</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>RPM</type>
									<appImage>${dist}/Copperhead</appImage>
									<licenseFile>${project.basedir}/../COPYING</licenseFile>
									<resourceDir>${project.basedir}/src/main/packaging/linux</resourceDir>
									<linuxPackageName>copperhead</linuxPackageName>
									<linuxAppCategory>Development/Tools</linuxAppCategory>
									<linuxMenuGroup>Development</linuxMenuGroup>
									<linuxShortcut>true</linuxShortcut>
									<icon>${project.basedir}/src/main/packaging/icons/copperhead-1024x1024.png</icon>
									<linuxPackageDeps>nss, mesa-libgbm, gtk3, alsa-lib, libXScrnSaver, libXtst, libXi, cups-libs, at-spi2-atk, libxkbcommon, libX11</linuxPackageDeps>
									<linuxRpmLicenseType>GPLv3</linuxRpmLicenseType>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
