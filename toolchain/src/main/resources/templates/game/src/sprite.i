; Sprite 0, a ship 16 pixels wide and 16 lines high. Each line is two words: the first holds the low
; bit of every pixel's colour, the second the high bit, so a pixel shows colour 17 (first word only),
; 18 (second only), 19 (both) or nothing. The two control words in front hold the position and are
; rewritten every frame; the two zero words after the last line end the sprite.

	even
sprite:
	dc.w	0,0
	dc.w	%0000000110000000,%0000000110000000
	dc.w	%0000001001000000,%0000001111000000
	dc.w	%0000001001000000,%0000001111000000
	dc.w	%0000010110100000,%0000011001100000
	dc.w	%0000010110100000,%0000011001100000
	dc.w	%0000100110010000,%0000111001110000
	dc.w	%0000100000010000,%0000111111110000
	dc.w	%0001000000001000,%0001111111111000
	dc.w	%0001000000001000,%0001111111111000
	dc.w	%0010000000000100,%0011111111111100
	dc.w	%0100000000000010,%0111111111111110
	dc.w	%1000000110000001,%1111111111111111
	dc.w	%1000001001000001,%1111111001111111
	dc.w	%1000010000100001,%1111110000111111
	dc.w	%1111100000011111,%1111100000011111
	dc.w	%0000000000000000,%0000000000000000
	dc.w	0,0
